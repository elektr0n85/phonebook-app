# Phonebook Application - Environment Variables
# GOTOWY DO UŻYCIA - Po prostu skopiuj ten plik jako .env

# ==============================================================================
# DATABASE (PostgreSQL w Docker kontenerze)
# ==============================================================================
POSTGRES_DB=phonebook_db
POSTGRES_USER=phonebook_user
# HASŁO PONIŻEJ - możesz zmienić na swoje lub zostawić to
POSTGRES_PASSWORD=MySecureDockerPass123!

# ==============================================================================
# BACKEND (FastAPI)
# ==============================================================================
# SECRET_KEY - już wygenerowany, możesz zmienić jeśli chcesz
SECRET_KEY=8a7b6c5d4e3f2a1b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - adresy które mogą łączyć się z API
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# Environment
ENVIRONMENT=development
DEBUG=False

# ==============================================================================
# FRONTEND (React)
# ==============================================================================
VITE_API_URL=http://localhost:8000/api/v1

# ==============================================================================
# OPCJONALNE - Rate Limiting (możesz zostawić)
# ==============================================================================
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_15MIN=5

# ==============================================================================
# UWAGI:
# ==============================================================================
# 1. POSTGRES_PASSWORD - to hasło TYLKO dla bazy w Docker kontenerze
#    (NIE dla Twojego lokalnego PostgreSQL jeśli go zainstalowałeś)
#
# 2. SECRET_KEY - używany do podpisywania JWT tokenów
#    (już wygenerowany losowo, bezpieczny)
#
# 3. Dla produkcji zmień:
#    - ALLOWED_ORIGINS na swoje domeny
#    - DEBUG=False
#    - ENVIRONMENT=production
#
# 4. Ten plik NIE POWINIEN być w git!
#    (jest w .gitignore, ale uważaj)
