# Database Configuration
DATABASE_URL=postgresql+asyncpg://phonebook_user:strong_password@localhost:5432/phonebook_db

# Security
SECRET_KEY=your-secret-key-min-32-characters-long-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_15MIN=5

# Environment
ENVIRONMENT=development
DEBUG=True

# App Info
PROJECT_NAME=Phonebook API
VERSION=1.0.0
API_V1_STR=/api/v1

# Email / SMTP Configuration
# For SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_USER=apikey
#   SMTP_PASSWORD=your_sendgrid_api_key
#
# For Gmail (enable "Less secure apps" or use App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_app_password
#
# For Mailgun:
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_USER=postmaster@your_domain.mailgun.org
#   SMTP_PASSWORD=your_mailgun_password

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_or_api_key
MAIL_FROM=noreply@phonebook-app.com
MAIL_FROM_NAME=Phonebook App

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Password reset token expiration (hours)
RESET_TOKEN_EXPIRE_HOURS=1
