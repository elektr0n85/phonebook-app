# Database Configuration
DATABASE_URL=postgresql+asyncpg://phonebook_user:strong_password@localhost:5432/phonebook_db

# Security
SECRET_KEY=your-secret-key-min-32-characters-long-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_15MIN=5

# Environment
ENVIRONMENT=development
DEBUG=True

# Email (for password reset - optional for now)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@phonebook.app
